---
import gametime from '../images/experience/gametime.svg'
import ieebc from '../images/experience/ieebc.svg'
import timbox from '../images/experience/timbox.svg'
import srax from '../images/experience/srax.svg'
import iconos from '../images/experience/iconos.webp'
import { ChevronDown } from 'lucide-astro'

import Company from './Company.astro'

const EXPERIENCE = [
  {
    name: 'Gametime',
    logo: gametime,
    role: 'Software Engineer',
    time: 'Mar 2022 - Present',
    highlights: [
      'Build reusable frontend systems in close partnership with Design, Product, and Backend teams.',
      'Delivered SEO improvements that increased user conversion across the web product.',
      'Ship product releases and strengthen code quality through active review and collaboration.'
    ]
  },
  {
    name: 'IEEBC',
    logo: ieebc,
    role: 'Full-stack Software Engineer',
    time: 'Nov 2019 - Mar 2022',
    highlights: [
      'Designed and maintained electoral systems that reduced data discrepancies by 30%.',
      'Built Django REST APIs that improved internal data tracking and management.',
      'Managed critical electoral data workflows during active elections.'
    ]
  },
  {
    name: 'Timbox',
    logo: timbox,
    role: 'Software Engineer',
    time: 'Feb 2018 - Dec 2018',
    highlights: [
      'Developed and maintained SOAP services with Ruby on Rails.',
      'Integrated OpenPay to streamline payment processing.',
      'Built AngularJS workflows for invoice stamping and credit tracking.'
    ]
  },
  {
    name: 'SRAX',
    logo: srax,
    role: 'Software Engineer',
    time: 'Oct 2016 - Feb 2018',
    highlights: [
      'Built Laravel REST API services and dynamic Handlebars templates.',
      'Automated server configuration with Puppet to reduce deployment time.',
      'Improved the scalability and consistency of infrastructure resources.'
    ]
  },
  {
    name: 'Iconos',
    logo: iconos,
    role: 'Software Developer & IT Support',
    time: 'Dec 2010 - Sep 2016',
    highlights: [
      'Developed business process automation systems for more than 10 regional companies.',
      'Reduced client system downtime by 40% through effective IT support.',
      'Led software migrations tailored to each client environment.'
    ]
  }
]

const recentExperience = EXPERIENCE.slice(0, 3)
const earlierExperience = EXPERIENCE.slice(3)
---

<section class='experience' id='experience'>
  <div class='responsive-content experience-content'>
    <header class='section-header'>
      <p class='eyebrow'>Experience</p>
      <h2>Shipping software across products and public systems</h2>
      <p>
        A career spanning consumer products, civic technology, financial
        systems, and business operations.
      </p>
    </header>
    <ol class='timeline'>
      {
        recentExperience.map((company) => {
          return <Company {...company} />
        })
      }
    </ol>
    <details class='earlier-experience'>
      <summary>
        <span>
          <strong>Earlier experience</strong>
          <small>2 roles · 2010-2018</small>
        </span>
        <ChevronDown size={20} aria-hidden='true' />
      </summary>
      <ol class='timeline earlier-timeline'>
        {
          earlierExperience.map((company) => {
            return <Company {...company} />
          })
        }
      </ol>
    </details>
  </div>
</section>

<style>
  .experience {
    padding: 88px 0;
  }

  .experience-content {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: 80px;
  }

  h2 {
    max-width: 500px;
    margin-top: 14px;
  }

  .section-header > p:last-child {
    max-width: 500px;
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.6;
  }

  .timeline {
    position: relative;
    border-inline-start: 1px solid var(--border);
  }

  .earlier-experience {
    grid-column: 2;
    margin-top: -40px;
  }

  summary {
    display: flex;
    min-height: 62px;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.04);
  }

  summary span {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  summary strong {
    font-size: 15px;
  }

  summary small {
    color: var(--subtle);
    font-size: 13px;
  }

  summary :global(svg) {
    transition: transform 150ms ease;
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .earlier-timeline {
    margin-top: 34px;
  }

  @media (max-width: 760px) {
    .experience {
      padding: 64px 0;
    }

    .experience-content {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .section-header > p:last-child {
      font-size: 17px;
    }

    .earlier-experience {
      grid-column: 1;
      margin-top: -18px;
    }
  }
</style>
