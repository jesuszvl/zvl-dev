---
import { Image } from 'astro:assets'

interface Props {
  name: string
  logo: any
  role: string
  time: string
  highlights: string[]
}

const { name, logo, role, time, highlights } = Astro.props
---

<li>
  <span class='dot' aria-hidden='true'></span>
  <div class='role-header'>
    <div>
      <h3>{role}</h3>
      <p class='company-name'>{name}</p>
    </div>
    <time>{time}</time>
  </div>
  <Image class='company-logo' src={logo} alt={`${name} logo`} height={32} />
  <ul class='highlights'>
    {highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>
</li>

<style>
  :global(.timeline > li) {
    position: relative;
    margin: 0 0 42px 26px;
    padding-bottom: 42px;
    border-bottom: 1px solid var(--border);
  }

  :global(.timeline > li:last-child) {
    margin-bottom: 0;
  }

  .role-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  h3 {
    font-size: 22px;
  }

  .company-name {
    margin-top: 5px;
    color: var(--accent);
    font-size: 15px;
    font-weight: 650;
  }

  time {
    flex: 0 0 auto;
    padding-top: 4px;
    color: var(--subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 12px;
    font-weight: 600;
  }

  :global(.company-logo) {
    width: auto;
    max-width: 132px;
    height: 28px;
    margin-top: 22px;
    object-fit: contain;
    object-position: left center;
  }

  .highlights {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }

  .highlights li {
    position: relative;
    padding-left: 18px;
    font-size: 16px;
    line-height: 1.55;
  }

  .highlights li::before {
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    content: '';
  }

  .dot {
    position: absolute;
    top: 5px;
    left: -32px;
    width: 11px;
    height: 11px;
    border: 2px solid var(--background);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  @media (max-width: 560px) {
    .role-header {
      flex-direction: column;
      gap: 8px;
    }

    time {
      padding-top: 0;
    }

    h3 {
      font-size: 20px;
    }
  }
</style>
