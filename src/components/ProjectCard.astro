---
import { Image } from 'astro:assets'
import { ExternalLink } from 'lucide-astro'

interface Props {
  title: string
  category: string
  description: string
  focus: string
  image: any
  url?: string
  color: string
  featured?: boolean
}

const { title, category, description, focus, image, url, color, featured } =
  Astro.props
---

<article
  class:list={['project', { featured }]}
  style={`--project-accent: ${color}`}
>
  <div class='info'>
    <p class='category'>{category}</p>
    <h3>{title}</h3>
    <p class='description'>{description}</p>
    <p class='focus'>{focus}</p>
    {
      url ? (
        <a
          class='project-link'
          href={url}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`View ${title} live site in a new tab`}
        >
          View live site
          <ExternalLink size={17} aria-hidden='true' />
        </a>
      ) : (
        <p class='project-status'>Project archive</p>
      )
    }
  </div>
  <div class='media'>
    <Image src={image} alt={`${title} product interface`} />
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    transition:
      transform 150ms ease,
      border-color 150ms ease;
  }

  .project::before {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    background: var(--project-accent);
    content: '';
  }

  .project:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.26);
  }

  .featured {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.15fr);
  }

  .info {
    display: flex;
    min-height: 280px;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
  }

  .featured .info {
    min-height: 380px;
    justify-content: center;
    padding: 44px;
  }

  .category {
    color: var(--project-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h3 {
    margin-top: 14px;
    font-size: 25px;
  }

  .featured h3 {
    font-size: 36px;
  }

  .description {
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.55;
  }

  .featured .description {
    max-width: 480px;
    font-size: 18px;
  }

  .focus {
    margin-top: 18px;
    color: var(--subtle);
    font-size: 13px;
    font-weight: 600;
  }

  .project-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--text);
    font-size: 15px;
    font-weight: 700;
  }

  .project-link:hover {
    color: var(--accent);
  }

  .project-status {
    min-height: 44px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--subtle);
    font-size: 13px;
    font-weight: 650;
    line-height: 20px;
  }

  .media {
    display: flex;
    min-height: 210px;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    background: #090c0b;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
  }

  .featured .media :global(img) {
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured .info {
      min-height: 0;
      padding: 34px;
    }

    .featured .media :global(img) {
      height: auto;
    }
  }

  @media (max-width: 760px) {
    .info,
    .featured .info {
      min-height: 0;
      padding: 24px;
    }

    .featured h3 {
      font-size: 30px;
    }
  }
</style>
