---
const skillGroups = [
  {
    id: 'languages',
    title: 'Core languages',
    skills: ['JavaScript', 'TypeScript', 'Python', 'Ruby', 'PHP', 'Java']
  },
  {
    id: 'frontend',
    title: 'Frontend systems',
    skills: ['HTML', 'CSS', 'React', 'Next.js', 'Astro']
  },
  {
    id: 'backend',
    title: 'Backend & data',
    skills: ['Node.js', 'Express', 'Django', 'Rails', 'Supabase', 'MongoDB']
  }
]
---

<section class='skillset' id='skills'>
  <div class='responsive-content skills-content'>
    <header>
      <p class='eyebrow'>Expertise</p>
      <h2>Broad across the stack, focused on the product</h2>
      <p class='intro'>
        The tools change with the problem. The constant is maintainable systems,
        clear interfaces, and dependable delivery.
      </p>
    </header>
    <div class='skill-groups'>
      {
        skillGroups.map((group) => (
          <section class='skill-group' aria-labelledby={`skill-${group.id}`}>
            <h3 id={`skill-${group.id}`}>{group.title}</h3>
            <ul>
              {group.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skillset {
    padding: 88px 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .skills-content {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
    gap: 80px;
  }

  h2 {
    max-width: 500px;
    margin-top: 14px;
  }

  .intro {
    max-width: 520px;
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.6;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 28px;
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }

  .skill-group:last-child {
    border-bottom: 1px solid var(--border);
  }

  h3 {
    padding-top: 7px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  li {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    line-height: 32px;
  }

  @media (max-width: 760px) {
    .skillset {
      padding: 64px 0;
    }

    .skills-content {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .intro {
      font-size: 17px;
    }

    .skill-group {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    h3 {
      padding-top: 0;
    }
  }
</style>
