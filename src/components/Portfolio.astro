---
import ProjectCard from './ProjectCard.astro'
import makahcoImage from '../images/portfolio/makahco.webp'
import vodyetImage from '../images/portfolio/vodyet.webp'
import prepLibreImage from '../images/portfolio/preplibre.webp'
import playlistImage from '../images/portfolio/playlist.webp'

const projects = [
  {
    title: 'MAKAHCO',
    category: 'Creative product',
    description:
      'A mobile-first collection of writing prompts and freestyle practice tools built for fast, distraction-free sessions.',
    focus: 'Product engineering · Mobile interaction',
    image: makahcoImage,
    color: '#fcd926',
    featured: true
  },
  {
    title: 'VODYET',
    category: 'Personal finance',
    description:
      'Expense tracking, category budgets, credit, and recurring payments brought into one focused workflow.',
    focus: 'Full-stack product · Financial workflows',
    url: 'https://vodyet.com',
    image: vodyetImage,
    color: '#44b95d'
  },
  {
    title: 'PREP LIBRE',
    category: 'Civic technology',
    description:
      'An open platform for managing and publishing preliminary electoral results with transparency at its core.',
    focus: 'System design · Public data',
    image: prepLibreImage,
    color: '#f2a03d'
  },
  {
    title: 'VS MY PLAYLIST',
    category: 'Music tool',
    description:
      'A lightweight Spotify playlist organizer for comparing tracks and making quicker listening decisions.',
    focus: 'Frontend engineering · Spotify API',
    url: 'https://jesuszvl.github.io/vs-my-playlist',
    image: playlistImage,
    color: '#8b85e8'
  }
]
---

<section class='portfolio' id='projects'>
  <div class='responsive-content'>
    <header class='section-header'>
      <p class='eyebrow'>Selected work</p>
      <div>
        <h2>Products built around real workflows</h2>
        <p>
          From creative tools to public data and personal finance, each project
          starts with a clear job for the user.
        </p>
      </div>
    </header>
    <div class='projects'>
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </div>
</section>

<style>
  .portfolio {
    padding: 88px 0;
    border-bottom: 1px solid var(--border);
  }

  .section-header {
    display: grid;
    grid-template-columns: 180px minmax(0, 720px);
    gap: 40px;
    margin-bottom: 48px;
  }

  .section-header h2 {
    max-width: 620px;
  }

  .section-header div > p {
    max-width: 620px;
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.55;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 900px) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .portfolio {
      padding: 64px 0;
    }

    .section-header {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 32px;
    }

    .section-header div > p {
      font-size: 17px;
    }

    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
