---
import { Check, Copy, Mail } from 'lucide-astro'
---

<section class='contact' id='contact'>
  <div class='responsive-content contact-content'>
    <div>
      <p class='eyebrow'>Start a conversation</p>
      <h2>Have a product to ship?</h2>
    </div>
    <div class='contact-details'>
      <p>
        I am always interested in thoughtful products, difficult engineering
        problems, and teams that care about the details.
      </p>
      <div class='contact-actions'>
        <a class='email-link' href='mailto:jesus@zvl.dev'>
          <Mail size={19} aria-hidden='true' />
           jesus@zvl.dev
        </a>
        <button
          class='copy-button'
          type='button'
          data-copy-email='jesus@zvl.dev'
          aria-label='Copy email address'
          title='Copy email address'
        >
          <span class='copy-icon'><Copy size={18} aria-hidden='true' /></span>
          <span class='check-icon'><Check size={18} aria-hidden='true' /></span>
        </button>
      </div>
      <p class='copy-status' aria-live='polite'></p>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 80px 0;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 80px;
    align-items: start;
  }

  h2 {
    max-width: 480px;
    margin-top: 14px;
  }

  .contact-details > p:first-child {
    max-width: 560px;
    font-size: 19px;
    line-height: 1.6;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }

  .email-link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 9px;
    padding: 0 18px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--background);
    font-weight: 750;
    transition:
      transform 150ms ease,
      background-color 150ms ease;
  }

  .email-link:hover {
    transform: translateY(-2px);
    background: var(--text);
  }

  .copy-button {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text);
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .copy-button:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
  }

  .check-icon,
  .copy-button[data-copied='true'] .copy-icon {
    display: none;
  }

  .copy-button[data-copied='true'] .check-icon {
    display: block;
    color: var(--accent);
  }

  .copy-status {
    min-height: 20px;
    margin-top: 8px;
    color: var(--accent);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .contact {
      padding: 56px 0;
    }

    .contact-content {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .contact-details > p:first-child {
      font-size: 17px;
    }
  }
</style>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>('[data-copy-email]')
  const copyStatus = document.querySelector<HTMLElement>('.copy-status')

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail
    if (!email) return

    try {
      await navigator.clipboard.writeText(email)
      copyButton.dataset.copied = 'true'
      copyButton.setAttribute('aria-label', 'Email address copied')
      if (copyStatus) copyStatus.textContent = 'Email copied'

      window.setTimeout(() => {
        delete copyButton.dataset.copied
        copyButton.setAttribute('aria-label', 'Copy email address')
        if (copyStatus) copyStatus.textContent = ''
      }, 2200)
    } catch {
      if (copyStatus)
        copyStatus.textContent = 'Could not copy the email address'
    }
  })
</script>
