---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import profile from '../images/profile.webp'
import nowildo from '../images/portfolio/nowildo.webp'
import mexicalivip from '../images/portfolio/mexicalivip.webp'
import preplibre from '../images/portfolio/preplibre.webp'
import vodyet from '../images/portfolio/vodyet.webp'

const projects = [
  {
    title: 'NoWildo',
    tag: 'Community platform · Live since 2024',
    description:
      'The site of a late-night Spanish-language Twitch channel: a film archive fed by TMDB, a daily guess-the-movie game, raffles, a site currency with its own slot machine, a 3D desert arcade and a poster bracket on a pannable map. Astro, Supabase and Twitch login, with much of the logic in Postgres.',
    image: nowildo,
    links: [{ label: 'nowildo.com', href: 'https://nowildo.com' }]
  },
  {
    title: 'mexicali.vip',
    tag: 'Small business · Storefront',
    description:
      "A storefront for a maker of handmade party centerpieces in Mexicali. Designs are browsed by the birthday kid's age, every piece gets its own indexable, shareable page, several can be viewed in 3D and placed on your own table in AR, and orders go straight to WhatsApp. Next.js.",
    image: mexicalivip,
    links: [{ label: 'mexicali.vip', href: 'https://mexicali.vip' }]
  },
  {
    title: 'PREP Libre',
    tag: 'Civic tech · Open source',
    description:
      "An open-source Preliminary Electoral Results Program for Mexico's local electoral bodies, built on the INE's Anexo 13 rules: a Postgres schema derived from the official formats, Baja California's districting seeded from INE data, SQL-level tests and a public demo. In design and architecture, shaped by my years at IEEBC.",
    image: preplibre,
    links: [{ label: 'preplibre.vercel.app', href: 'https://preplibre.vercel.app' }]
  },
  {
    title: 'Vodyet',
    tag: 'Personal finance · PWA',
    description:
      "A Spanish-language expense tracker: monthly budgets by category, credit balances, recurring payments and a spending trend chart, behind Google sign-in with row-level security so every record stays the user's own. React, Vite and Supabase, installable as a PWA.",
    image: vodyet,
    links: [{ label: 'vodyet.com', href: 'https://vodyet.com' }]
  }
]

const jobs = [
  {
    time: '2022 – Now',
    company: 'Gametime',
    role: 'Software Engineer · Remote',
    summary:
      'Frontend systems for the web product, in close partnership with Design, Product and Backend. Led SEO work that lifted conversion across the site, and raise the bar on quality through code review.'
  },
  {
    time: '2019 – 2022',
    company: 'IEEBC',
    role: 'Full-stack Software Engineer · Instituto Estatal Electoral de Baja California',
    summary:
      'Designed and maintained the systems used during live elections, cutting data discrepancies by 30%, and built Django REST APIs for internal data tracking.'
  },
  {
    time: '2018',
    company: 'Timbox',
    role: 'Software Engineer',
    summary:
      'SOAP services in Ruby on Rails, OpenPay payment integration, and AngularJS workflows for invoice stamping and credit tracking.'
  },
  {
    time: '2016 – 2018',
    company: 'SRAX',
    role: 'Software Engineer',
    summary:
      'Laravel REST APIs and Handlebars templates. Automated server configuration with Puppet to cut deployment time.'
  },
  {
    time: '2010 – 2016',
    company: 'Iconos',
    role: 'Software Developer & IT Support',
    summary:
      'Business-process automation for more than ten regional companies, plus IT support that cut client downtime by 40%.'
  }
]

const toolbox = [
  ['Frontend', 'TypeScript, React, Next.js, Astro, HTML & CSS'],
  ['Backend', 'Node.js, Express, Django, Ruby on Rails, Supabase, MongoDB'],
  ['Also', 'Python, Ruby, PHP, Java']
]
---

<Layout>
  <section class='hero wrap'>
    <div>
      <p class='kicker'>Product engineer · Web · Since 2010</p>
      <h1>I turn product ideas into software people <em>actually use</em>.</h1>
      <p class='lede'>
        I'm Jesús Zavala, a software engineer on the web team at Gametime,
        working remotely from Mexicali, México. For fifteen years I've taken
        web products from a rough idea to something shipped, measured, and
        maintained.
      </p>
      <div class='actions'>
        <a class='btn' href='mailto:jesus@zvl.dev'>Email me</a>
        <a href='#work'>See the work ↓</a>
        <a href='https://github.com/jesuszvl' target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
        <a href='https://www.linkedin.com/in/jesuszvl/' target='_blank' rel='noopener noreferrer'>LinkedIn ↗</a>
      </div>
    </div>
    <div class='portrait'>
      <Image src={profile} alt='Portrait of Jesús Zavala' width={400} height={400} quality={90} loading='eager' />
    </div>
    <dl class='facts'>
      <div><dt>Now</dt><dd>Software Engineer, Gametime</dd></div>
      <div><dt>Based in</dt><dd>Mexicali, México</dd></div>
      <div><dt>Time zone</dt><dd>Pacific · <span data-clock>same as California</span></dd></div>
      <div><dt>Languages</dt><dd>Spanish (native) · English (C2)</dd></div>
    </dl>
  </section>

  <section id='work'>
    <div class='wrap'>
      <header>
        <p class='kicker'>Selected work</p>
        <h2>Products I built end to end.</h2>
      </header>
      <ol class='projects'>
        {
          projects.map((p, i) => (
            <li class='project'>
              <div>
                <p class='kicker'>{String(i + 1).padStart(2, '0')}</p>
                <h3>{p.title}</h3>
                <p class='tag'>{p.tag}</p>
                <p class='desc'>{p.description}</p>
                {p.links.length > 0 && (
                  <p class='links'>
                    {p.links.map((l) => (
                      <a href={l.href} target='_blank' rel='noopener noreferrer'>
                        {l.label} ↗
                      </a>
                    ))}
                  </p>
                )}
              </div>
              <div class='shot'>
                <Image src={p.image} alt={`${p.title} homepage`} width={1200} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id='experience'>
    <div class='wrap cols'>
      <header>
        <p class='kicker'>Experience</p>
        <h2>Since 2010, from regional businesses in Mexicali to a US consumer marketplace.</h2>
      </header>
      <ol class='jobs'>
        {
          jobs.map((j) => (
            <li class='job'>
              <time>{j.time}</time>
              <div>
                <h3>{j.company}</h3>
                <p class='role'>{j.role}</p>
                <p class='summary'>{j.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id='about'>
    <div class='wrap cols'>
      <header>
        <p class='kicker'>About</p>
        <h2>I care about the whole product, not just my slice.</h2>
      </header>
      <div>
        <div class='bio'>
          <p>
            Most of my career has been on small teams where the engineer who
            builds the feature is also the one who hears from the person using
            it. I like that. It made me a product engineer before I knew the
            term: someone who reads the analytics, questions the spec, and
            ships anyway.
          </p>
          <p>
            Off the clock I build the side projects above, mostly for the fun
            of taking something from zero to real.
          </p>
        </div>
        <ol class='principles'>
          <li>
            <strong>Start with the user's job.</strong>
            Before picking a stack I want to know what the feature has to do
            for someone, and how we'll know it did.
          </li>
          <li>
            <strong>Own it past launch.</strong>
            SEO, performance, accessibility and edge cases are part of the
            feature, not a follow-up ticket.
          </li>
          <li>
            <strong>Build for the next engineer.</strong>
            Reusable systems and boring, readable code, so the team ships
            faster next quarter too.
          </li>
        </ol>
        <dl class='details'>
          {
            toolbox.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
          <div><dt>Education</dt><dd>CETYS Universidad, 2012–2016</dd></div>
          <div><dt>English</dt><dd>C2 Proficient, EF SET certified</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section id='contact'>
    <div class='wrap cols'>
      <header>
        <p class='kicker'>Contact</p>
        <h2>Let's build something people use.</h2>
      </header>
      <div>
        <p class='lede'>
          Happy to talk about product engineering roles, hard problems, or the
          side project you can't stop thinking about.
        </p>
        <a class='email' href='mailto:jesus@zvl.dev'>jesus@zvl.dev</a>
        <p class='links'>
          <a href='https://github.com/jesuszvl' target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
          <a href='https://www.linkedin.com/in/jesuszvl/' target='_blank' rel='noopener noreferrer'>LinkedIn ↗</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3.5rem, 7vw, 6rem);
    border-top: 0;
  }

  .hero > * {
    animation: rise 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 160ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  h1 {
    max-width: 18ch;
    margin-top: 1.25rem;
  }

  h1 em {
    color: var(--accent);
    white-space: nowrap;
  }

  .lede {
    max-width: 56ch;
    margin-top: 1.75rem;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
    font-weight: 500;
  }

  .actions a:not(.btn) {
    color: var(--ink);
  }

  .portrait {
    width: clamp(112px, 16vw, 240px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
  }

  .facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin-top: 0.375rem;
    color: var(--ink);
    font-weight: 500;
  }

  /* Two-column sections */
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .cols header {
    position: sticky;
    top: 2rem;
    margin-bottom: 0;
  }

  /* Work */
  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .project h3 {
    margin-top: 0.75rem;
  }

  .tag {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .desc {
    max-width: 44ch;
    margin-top: 1.25rem;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .links a {
    color: var(--ink);
  }

  .shot {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--paper-2);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project:hover .shot img {
    transform: scale(1.02);
  }

  /* Experience */
  .job {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .job:last-child {
    border-bottom: 1px solid var(--line);
  }

  .job time {
    padding-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .job h3 {
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .role {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .summary {
    max-width: 60ch;
    margin-top: 0.625rem;
  }

  /* About */
  .bio {
    max-width: 58ch;
  }

  .bio p + p {
    margin-top: 1.25rem;
  }

  .principles {
    display: grid;
    gap: 1.25rem;
    max-width: 58ch;
    margin-top: 2.5rem;
    counter-reset: n;
  }

  .principles li {
    position: relative;
    padding-left: 2.5rem;
  }

  .principles li::before {
    content: counter(n, decimal-leading-zero);
    counter-increment: n;
    position: absolute;
    top: 0.3em;
    left: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .principles strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .details dd {
    font-weight: 400;
  }

  /* Contact */
  .email {
    display: inline-block;
    margin-top: 2rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .email:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .hero,
    .cols,
    .project,
    .job {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      order: -1;
    }

    .cols header {
      position: static;
    }

    .shot {
      order: -1;
    }

    .job {
      gap: 0.25rem;
    }
  }
</style>
