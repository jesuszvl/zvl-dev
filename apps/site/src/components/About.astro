---
import Icon from './Icon.astro'
import { capabilities } from '../data/portfolio'
---

<section id='about' class='section about' aria-labelledby='about-title'>
  <div class='intro'>
    <div>
      <p class='eyebrow'>A bit about me</p>
      <h2 id='about-title'>Curious by nature.<br />Engineer by practice.</h2>
    </div>
    <div class='copy'>
      <p>
        I like being close to the whole product: understanding the problem,
        building the interface, shaping the data, and improving what happens
        after launch.
      </p>
      <p>
        Small teams taught me to care about all of it. Outside my day job, I
        build projects for the simple satisfaction of turning “what if” into
        something someone can use.
      </p>
      <a
        class='text-link'
        href='https://www.linkedin.com/in/jesuszvl/'
        target='_blank'
        rel='noopener noreferrer'
      >
        More about my background <Icon name='arrow-up-right' size={16} />
      </a>
    </div>
  </div>
  <div class='capabilities'>
    {
      capabilities.map((capability) => (
        <div class='capability'>
          <h3>{capability.label}</h3>
          <p>{capability.description}</p>
          <span>{capability.tools}</span>
        </div>
      ))
    }
  </div>
  <dl class='facts'>
    <div><dt>Home base</dt><dd>Mexicali, México · Pacific time</dd></div>
    <div><dt>Languages</dt><dd>Spanish & English <span>(C2)</span></dd></div>
    <div><dt>Education</dt><dd>CETYS Universidad <span>2012–2016</span></dd></div>
  </dl>
</section>

<style>
  .about {
    padding-bottom: 80px;
  }
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .intro h2 {
    margin-top: 16px;
    font-size: clamp(30px, 3.05vw, 42px);
    line-height: 1.14;
    letter-spacing: -0.05em;
  }
  .copy {
    font-size: 13px;
    line-height: 1.85;
  }
  .copy p + p {
    margin-top: 16px;
  }
  .copy a {
    margin-top: 20px;
    font-size: 11px;
  }
  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }
  .capability {
    padding-top: 20px;
    border-top: 2px solid var(--line);
  }
  .capability h3 {
    font-size: 13px;
    font-weight: 500;
  }
  .capability p {
    max-width: 29ch;
    margin-top: 8px;
    font-size: 12px;
  }
  .capability span {
    display: block;
    margin-top: 16px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.8;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 10px;
  }
  dt {
    margin-bottom: 4px;
    color: var(--muted);
  }
  dd {
    color: var(--ink);
  }
  dd span {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .intro {
      gap: 28px;
    }
  }
  @media (max-width: 600px) {
    .about {
      padding-bottom: 48px;
    }
    .intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .intro h2 {
      font-size: 36px;
    }
    .copy {
      font-size: 14px;
    }
    .capabilities,
    .facts {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 32px;
    }
    .capability p {
      max-width: none;
      font-size: 13px;
    }
    .capability span {
      font-size: 10px;
    }
    .facts div {
      display: grid;
      grid-template-columns: 85px 1fr;
      gap: 16px;
    }
    dt {
      margin: 0;
    }
    dd {
      font-size: 11px;
    }
  }
</style>
