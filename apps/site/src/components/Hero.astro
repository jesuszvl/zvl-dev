---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import { portrait, portraitAlt } from '../lib/portrait'
---

<section class='intro' id='intro' aria-labelledby='intro-title'>
  <div class='topline'>
    <p class='eyebrow'>A portfolio of things made real</p>
    <p class='local-time'>
      <span class='status-dot' aria-hidden='true'></span> Mexicali, MX
      <span class='divider'>/</span>
      <span data-clock>Pacific time</span>
    </p>
  </div>
  <div class='hero'>
    <div>
      <p class='hello'>Hey, I’m Jesús <span aria-hidden='true'>✳</span></p>
      <h1 id='intro-title'>Good ideas.<br />Thoughtful<br /><span>software.</span></h1>
      <p class='description'>
        I’m a software engineer who connects the dots between a product idea and
        the people using it.
      </p>
      <p class='context'>
        Building for the web since 2010. Currently at <strong>Gametime.</strong>
      </p>
      <div class='actions'>
        <a class='button' href='#work'>Explore my work <Icon name='arrow-down' size={17} /></a>
        <a class='text-link' href='mailto:hi@jesuszavala.dev'>Let’s talk <Icon name='arrow-up-right' size={18} /></a>
      </div>
    </div>
    <div class='portrait'>
      <div class='portrait-image'>
        <Image
          src={portrait}
          alt={portraitAlt}
          widths={[360, 540, 720]}
          sizes='(max-width: 600px) 90vw, (max-width: 900px) 35vw, 30vw'
          width={540}
          height={720}
          quality={85}
          loading='eager'
        />
      </div>
    </div>
  </div>
</section>

<script>
  const clock = document.querySelector('[data-clock]')
  const format = new Intl.DateTimeFormat('en-US', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'America/Tijuana'
  })
  const tick = () => {
    if (clock) clock.textContent = format.format(new Date())
  }
  tick()
  setInterval(tick, 30_000)
</script>

<style>
  .intro {
    padding-top: 36px;
  }
  .topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .topline .eyebrow {
    font-size: 10px;
  }
  .local-time {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font: 10px/1.4 var(--mono);
    white-space: nowrap;
  }
  .local-time .status-dot {
    width: 5px;
    height: 5px;
  }
  .divider {
    color: #a0a7b5;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 68px);
    padding: 72px 0 64px;
  }
  .hello {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    color: var(--ink);
    font-size: 14px;
  }
  .hello span {
    color: var(--accent);
    font-size: 23px;
    line-height: 1;
  }
  h1 {
    font-size: clamp(57px, 6.25vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  h1 span {
    color: var(--accent);
  }
  .description {
    max-width: 38ch;
    margin-top: 28px;
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.75;
  }
  .context {
    max-width: 42ch;
    margin-top: 12px;
    color: var(--muted);
    font-size: 12px;
  }
  .context strong {
    color: var(--ink);
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }
  .portrait {
    width: 100%;
    max-width: 420px;
    justify-self: end;
    padding-top: 16px;
  }
  .portrait-image {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: 11px;
    background: transparent;
  }
  .portrait-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .intro {
      padding-top: 28px;
    }
    .hero {
      padding-top: 48px;
    }
    h1 {
      font-size: clamp(56px, 9vw, 80px);
    }
    .portrait {
      padding-top: 0;
    }
  }
  @media (max-width: 600px) {
    .topline {
      align-items: start;
    }
    .topline .eyebrow {
      max-width: 20ch;
      font-size: 9px;
    }
    .local-time {
      flex-wrap: wrap;
      justify-content: end;
      font-size: 9px;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 40px 0 32px;
    }
    h1 {
      font-size: clamp(54px, 16vw, 85px);
    }
    .description {
      max-width: 35ch;
      margin-top: 24px;
    }
    .context {
      font-size: 11px;
    }
    .portrait {
      max-width: none;
    }
  }
</style>
