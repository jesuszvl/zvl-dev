---
import Icon from './Icon.astro'
---

<section id='contact' class='contact' aria-labelledby='contact-title'>
  <div class='top'>
    <p class='eyebrow'>Good things start with a conversation</p>
    <Icon name='arrow-up-right' size={34} />
  </div>
  <h2 id='contact-title'>What are you<br />working on?</h2>
  <p class='description'>
    A product to build, a problem to untangle, or a team that cares about the
    details. I’d love to hear about it.
  </p>
  <div class='bottom'>
    <div class='email'>
      <a href='mailto:hi@jesuszavala.dev'>hi@jesuszavala.dev</a>
      <button type='button' aria-label='Copy email address' title='Copy email address' data-copy hidden>
        <Icon name='copy' size={18} />
      </button>
      <span role='status' aria-live='polite' data-copy-status></span>
    </div>
    <div class='links'>
      <a href='https://github.com/jesuszvl' target='_blank' rel='noopener noreferrer'>
        GitHub <Icon name='arrow-up-right' size={15} />
      </a>
      <a href='https://www.linkedin.com/in/jesuszvl/' target='_blank' rel='noopener noreferrer'>
        LinkedIn <Icon name='arrow-up-right' size={15} />
      </a>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]')
  const status = document.querySelector<HTMLElement>('[data-copy-status]')
  if (button && status && navigator.clipboard?.writeText) {
    button.hidden = false
    let reset: ReturnType<typeof setTimeout>
    button.addEventListener('click', async () => {
      clearTimeout(reset)
      try {
        await navigator.clipboard.writeText('hi@jesuszavala.dev')
        status.textContent = 'Copied!'
        button.setAttribute('aria-label', 'Email address copied')
      } catch {
        status.textContent = 'Please select the email to copy it.'
      }
      reset = setTimeout(() => {
        status.textContent = ''
        button.setAttribute('aria-label', 'Copy email address')
      }, 4000)
    })
  }
</script>

<style>
  .contact {
    padding: 36px 40px 32px;
    border-radius: 12px;
    color: #dce3ff;
    background: var(--accent);
  }
  .contact .eyebrow {
    color: inherit;
    font-size: 9px;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .top :global(svg) {
    color: #fff;
  }
  h2 {
    margin-top: 24px;
    color: #fff;
    font-size: clamp(48px, 5.5vw, 75px);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .description {
    max-width: 48ch;
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.85;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid #ffffff38;
  }
  .email {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .email > a {
    color: #fff;
    font: 500 24px/1.4 var(--font-display);
    letter-spacing: -0.02em;
  }
  a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid #ffffff40;
    border-radius: 5px;
    color: #fff;
    background: transparent;
  }
  button[hidden] {
    display: none;
  }
  button:hover {
    background: #ffffff20;
  }
  [role='status'] {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    color: #fff;
    font-size: 10px;
  }
  .links {
    display: flex;
    gap: 20px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-size: 11px;
  }
  :focus-visible {
    outline-color: #fff;
  }

  @media (max-width: 900px) {
    .contact {
      padding-inline: 28px;
    }
  }
  @media (max-width: 600px) {
    .contact {
      padding: 24px 22px 32px;
    }
    .contact .eyebrow {
      max-width: 25ch;
      line-height: 1.7;
    }
    .top :global(svg) {
      width: 28px;
    }
    h2 {
      margin-top: 28px;
      font-size: clamp(45px, 11vw, 58px);
    }
    .description {
      font-size: 12px;
    }
    .bottom {
      margin-top: 28px;
      padding-top: 20px;
    }
    .email > a {
      font-size: 23px;
    }
  }
</style>
