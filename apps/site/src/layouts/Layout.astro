---
import { Font } from 'astro:assets'
import Icon from '../components/Icon.astro'
import PostHog from '../components/Posthog.astro'
import Sidebar from '../components/Sidebar.astro'
import { portrait } from '../lib/portrait'
import '../styles/global.css'

const title = 'Jesús Zavala — Software & Product Engineer'
const description =
  'Software engineer in Mexicali, México. Building thoughtful web products since 2010, from community platforms and local commerce to civic technology. Currently at Gametime.'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og-portfolio.jpg', Astro.site)
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jesús Zavala',
  url: canonicalURL.href,
  image:
    typeof portrait === 'string' ? portrait : new URL(portrait.src, Astro.site).href,
  jobTitle: 'Software Engineer',
  description,
  email: 'mailto:jesus@zvl.dev',
  worksFor: { '@type': 'Organization', name: 'Gametime' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'CETYS Universidad' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mexicali',
    addressRegion: 'Baja California',
    addressCountry: 'MX'
  },
  knowsLanguage: ['es', 'en'],
  sameAs: [
    'https://github.com/jesuszvl',
    'https://www.linkedin.com/in/jesuszvl/'
  ]
}
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonicalURL} />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='alternate icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <meta name='generator' content={Astro.generator} />
    <meta name='theme-color' content='#f7f8fa' />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={ogImageURL} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta
      property='og:image:alt'
      content='Jesús Zavala. Good ideas. Thoughtful software. Product engineer in Mexicali, México.'
    />
    <meta property='og:site_name' content={canonicalURL.host} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImageURL} />
    <Font cssVariable='--font-display' preload />
    <Font cssVariable='--font-sans' preload />
    <script
      type='application/ld+json'
      is:inline
      set:html={JSON.stringify(person)}
    />
    <PostHog />
  </head>
  <body>
    <a class='skip-link' href='#main'>Skip to content</a>
    <Sidebar />
    <div class='page'>
      <main id='main' tabindex='-1'><slot /></main>
      <footer class='footer'>
        <p>© {new Date().getFullYear()} Jesús Zavala</p>
        <a href='#intro'>Back to top <Icon name='arrow-up-right' size={16} /></a>
        <p>Built with Astro. Made to be used.</p>
      </footer>
    </div>
  </body>
</html>
