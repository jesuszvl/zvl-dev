---
import '../styles/admin.css'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex, nofollow' />
    <title>Portfolio Admin | Jesús Zavala</title>
  </head>
  <body>
    <!--
      THESIS: A private operating surface for publishing portfolio content and managing portrait assets, not a public marketing page.
      OWN-WORLD: Quiet editorial dashboard language, pale blue workspace, ink controls, dense tables, and small-radius panels.
      STORY: Sign in, confirm admin access, review content state, add portrait references, and record generation drafts.
      FIRST VIEWPORT: Login or dashboard fills the page; action rail stays at the top, work panels sit in a responsive grid.
      FORM: Code-led practical scaffold for a single-user Supabase admin.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <main class='admin-shell'>
      <section class='auth-shell' data-auth-panel>
        <div class='auth-card' aria-labelledby='login-title'>
          <span class='monogram' aria-hidden='true'>jz</span>
          <h1 id='login-title'>Portfolio Admin</h1>
          <p class='admin-subtitle'>Sign in to manage jesuszavala.dev</p>
          <form class='login-form' data-login-form>
            <label for='email'>Email</label>
            <div class='input-row'>
              <input
                id='email'
                name='email'
                type='email'
                inputmode='email'
                autocomplete='email'
                placeholder='you@example.com'
                required
              />
              <button type='submit'>Send link</button>
            </div>
          </form>
          <p class='status-copy' data-login-status role='status'></p>
        </div>
      </section>

      <section class='dashboard' data-dashboard hidden>
        <header class='topbar'>
          <div>
            <h1>Portfolio Admin</h1>
            <p class='admin-subtitle'>Content operations for jesuszavala.dev</p>
          </div>
          <div class='topbar-actions'>
            <button type='button' data-refresh>Refresh</button>
            <button type='button' class='secondary' data-sign-out>Sign out</button>
          </div>
        </header>

        <section class='status-strip' aria-label='Connection status'>
          <div>
            <span class='status-dot' aria-hidden='true'></span>
            <span data-admin-email>Signed in</span>
          </div>
          <div data-updated-at>Waiting for data</div>
        </section>

        <div class='workspace-grid'>
          <section class='panel span-2' aria-labelledby='content-title'>
            <div class='panel-header'>
              <div>
                <h2 id='content-title'>Portfolio versions</h2>
              </div>
              <button type='button' data-create-draft>Create draft</button>
            </div>
            <div class='table-shell'>
              <table>
                <thead>
                  <tr>
                    <th>Version</th>
                    <th>Status</th>
                    <th>Summary</th>
                    <th>Updated</th>
                  </tr>
                </thead>
                <tbody data-content-list>
                  <tr>
                    <td colspan='4'>No content loaded.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class='panel span-2' aria-labelledby='reference-title'>
            <div class='panel-header'>
              <div>
                <h2 id='reference-title'>Reference library</h2>
                <p class='admin-subtitle'>Photos the model uses to keep your likeness.</p>
              </div>
              <span class='count' data-reference-count></span>
            </div>
            <form class='inline-form' data-upload-form>
              <input
                id='portrait-reference'
                name='file'
                type='file'
                accept='image/png,image/jpeg,image/webp'
                multiple
                required
              />
              <button type='submit'>Add photos</button>
            </form>
            <div class='thumb-grid' data-asset-grid>
              <p class='empty'>No reference photos yet.</p>
            </div>
          </section>

          <section class='panel' aria-labelledby='generation-title'>
            <div class='panel-header'>
              <div>
                <h2 id='generation-title'>Portrait prompt</h2>
                <p class='admin-subtitle'>Build it here, generate in ChatGPT.</p>
              </div>
            </div>
            <form class='stack-form' data-generation-form>
              <div class='control-grid'>
                <div>
                  <label for='background'>Background</label>
                  <select id='background' name='background'>
                    <option value='transparent'>Transparent</option>
                    <option value='studio'>Studio grey</option>
                    <option value='solid'>Solid off-white</option>
                    <option value='office'>Blurred office</option>
                  </select>
                </div>
                <div>
                  <label for='outfit'>Outfit</label>
                  <select id='outfit' name='outfit'>
                    <option value='tee'>Plain black t-shirt</option>
                    <option value='shirt'>Button-down shirt</option>
                    <option value='hoodie'>Dark hoodie</option>
                    <option value='jacket'>Casual jacket</option>
                  </select>
                </div>
                <div>
                  <label for='framing'>Framing &amp; pose</label>
                  <select id='framing' name='framing'>
                    <option value='standing'>Standing, three-quarter</option>
                    <option value='half'>Half body, forward</option>
                    <option value='head'>Head and shoulders</option>
                  </select>
                </div>
                <div>
                  <label for='lighting'>Lighting &amp; mood</label>
                  <select id='lighting' name='lighting'>
                    <option value='studio'>Natural studio</option>
                    <option value='window'>Soft window</option>
                    <option value='dramatic'>Dramatic</option>
                    <option value='editorial'>Flat editorial</option>
                  </select>
                </div>
              </div>
              <label for='generation-notes'>Extra notes <span class='optional'>optional</span></label>
              <textarea
                id='generation-notes'
                name='notes'
                rows='2'
                placeholder='Anything else to steer the result.'
              ></textarea>
              <label for='prompt-preview'>Prompt</label>
              <textarea id='prompt-preview' data-prompt-preview rows='6' readonly></textarea>
              <button type='submit'>Copy prompt</button>
            </form>
            <p class='hint'>
              Paste it into ChatGPT with the selected reference photos, then
              upload the result below.
            </p>
            <form class='inline-form' data-result-form>
              <input
                id='portrait-result'
                name='file'
                type='file'
                accept='image/png,image/jpeg,image/webp'
                required
              />
              <button type='submit'>Add result</button>
            </form>
          </section>

          <section class='panel' aria-labelledby='results-title'>
            <div class='panel-header'>
              <div>
                <h2 id='results-title'>Generated portraits</h2>
                <p class='admin-subtitle'>Publishing replaces the hero image.</p>
              </div>
            </div>
            <div class='thumb-grid' data-generation-grid>
              <p class='empty'>Nothing generated yet.</p>
            </div>
          </section>
        </div>

        <p class='status-copy dashboard-status' data-dashboard-status role='status'></p>
      </section>
    </main>

    <script>
      import '../scripts/admin'
    </script>
  </body>
</html>
