# Built into the admin bundle at build time. Set both on the Vercel admin project.
PUBLIC_SUPABASE_URL=https://eeltmgmeuxnajoggevct.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret for the publish-portrait Edge Function:
#   supabase secrets set VERCEL_SITE_DEPLOY_HOOK_URL=...
